# Copy to .env (never commit .env). Everything is optional; Plexis runs fully offline by default.

# --- Amazon Bedrock (Strands Agents SDK) ---------------------------------
# PLEXIS_LLM=bedrock                         # escalate unparsed phrases to Bedrock and polish speech
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=...            # a Bedrock API key, or use any standard AWS credential source
# PLEXIS_PARSER_MODEL=us.amazon.nova-lite-v1:0
# PLEXIS_EXPLAINER_MODEL=us.amazon.nova-pro-v1:0
# PLEXIS_GUARDRAIL_ID=...                    # Amazon Bedrock Guardrails id for input screening
# PLEXIS_GUARDRAIL_VERSION=DRAFT

# --- Durability ---------------------------------------------------------
# PLEXIS_STATE_DIR=var
# PLEXIS_BACKUP_EVERY=25                     # ledger snapshot every N receipts
# PLEXIS_BACKUP_S3_BUCKET=my-plexis-backups     # off-site copy of each snapshot

# --- Security -------------------------------------------------------------
# PLEXIS_AUTH=true                           # Alexa+ two-tier OAuth (mcp:service / mcp:tools)
# PLEXIS_JWT_SECRET=...                      # otherwise generated into var/keys
# PLEXIS_ALEXA_COMPAT_401=false              # strip WWW-Authenticate on 401 if your host requires it
# PLEXIS_RATE_LIMIT_PER_MINUTE=240
# PLEXIS_MAX_BOOKING_USD=15000
# PLEXIS_ALLOWED_ORIGINS=http://localhost:5173

# --- Performance ----------------------------------------------------------
# PLEXIS_LATENCY_BUDGET_MS=500
# PLEXIS_SOLVER_TIME_LIMIT=2.0
# PLEXIS_SOLVER_WORKERS=8
# PLEXIS_PARTNER_TIMEOUT=1.5
# PLEXIS_CACHE_TTL=120

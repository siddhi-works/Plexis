# Copy to .env (never commit .env). Everything is optional; Plexis runs fully offline by default.

# --- Amazon Bedrock (Strands Agents SDK) ---------------------------------
# QED_LLM=bedrock                         # escalate unparsed phrases to Bedrock and polish speech
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=...            # a Bedrock API key, or use any standard AWS credential source
# QED_PARSER_MODEL=us.amazon.nova-lite-v1:0
# QED_EXPLAINER_MODEL=us.amazon.nova-pro-v1:0
# QED_GUARDRAIL_ID=...                    # Amazon Bedrock Guardrails id for input screening
# QED_GUARDRAIL_VERSION=DRAFT

# --- Durability ---------------------------------------------------------
# QED_STATE_DIR=var
# QED_BACKUP_EVERY=25                     # ledger snapshot every N receipts
# QED_BACKUP_S3_BUCKET=my-qed-backups     # off-site copy of each snapshot

# --- Security -------------------------------------------------------------
# QED_AUTH=true                           # Alexa+ two-tier OAuth (mcp:service / mcp:tools)
# QED_JWT_SECRET=...                      # otherwise generated into var/keys
# QED_ALEXA_COMPAT_401=false              # strip WWW-Authenticate on 401 if your host requires it
# QED_RATE_LIMIT_PER_MINUTE=240
# QED_MAX_BOOKING_USD=15000
# QED_ALLOWED_ORIGINS=http://localhost:5173

# --- Performance ----------------------------------------------------------
# QED_LATENCY_BUDGET_MS=500
# QED_SOLVER_TIME_LIMIT=2.0
# QED_SOLVER_WORKERS=8
# QED_PARTNER_TIMEOUT=1.5
# QED_CACHE_TTL=120

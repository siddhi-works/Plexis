{
  "name": "qed-alexa-plus-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A simulated Alexa+ host that is a real MCP client (initialize, tools/list, tools/call, elicitation, MCP Apps) for the QED add-on.",
